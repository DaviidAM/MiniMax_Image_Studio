# =============================================
# MiniMax Image Studio — environment template
# =============================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env — it's ignored by .gitignore.

# =============================================
# Required
# =============================================

# MiniMax API key (https://api.minimax.ai)
# Used by the backend to call image_generation and video_generation endpoints.
MINIMAX_API_KEY=

# =============================================
# Optional (compose defaults)
# =============================================

# Internal URL the frontend uses to reach the backend container.
# Only used by docker-compose; leave empty for local dev.
NEXT_PUBLIC_API_BASE_URL=http://backend:8000